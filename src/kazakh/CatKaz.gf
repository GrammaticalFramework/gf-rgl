concrete CatKaz of Cat = CommonX ** open Prelude,ResKaz in {
  lincat A = {s : Str} ;
  lincat A2 = A ** {c2 : Compl} ;
  lincat ACard = {s : Str} ;
  lincat AP = {s : Str} ;
  lincat CN = Noun ;
  lincat Card = {s : Str} ;
  lincat Cl = Clause ;
  lincat ClSlash = Clause ;
  lincat Comp = {s : Str} ;
  lincat Conj = {s : Str} ;
  lincat DAP = {s : Str} ;
  lincat Decimal = {s : Str} ;
  lincat Det = {s : Str; n : Number; poss : Possessor} ;
  lincat Digits = {s : Str} ;
  lincat GN = {s : Str} ;
  lincat IComp = {s : Str} ;
  lincat IDet = {s : Str; n : Number} ;
  lincat IP = {s : Str} ;
  lincat IQuant = {s : Str} ;
  lincat Imp = {s : Polarity => Formality => Number => Str} ;
  lincat LN = {s : Str} ;
  lincat N = Noun ;
  lincat N2 = Noun ** {c2 : Compl} ;
  lincat N3 = Noun ** {c2,c3 : Compl} ;
  lincat NP = {s : Case => Str; a : Agr} ;
  lincat Num = {s : Str; n : Number} ;
  lincat Numeral = {s : Str} ;
  lincat Ord = {s : Str} ;
  lincat PN = {s : Str} ;
  lincat Predet = {s : Str} ;
  lincat Prep = Compl ;
  lincat Pron = {s : Case => Str; a : Agr} ;
  lincat QCl = Clause ;
  lincat QS = {s : Str} ;
  lincat Quant = {s : Str; poss : Possessor} ;
  lincat RCl = {s : Str} ;
  lincat RP = {s : Str} ;
  lincat RS = {s : Str} ;
  lincat S = {s : Str} ;
  lincat SN = {s : Str} ;
  lincat SSlash = {s : Str} ;
  lincat Subj = {s : Str} ;
  lincat V = Verb ;
  lincat VV,VS,VQ,VA = Verb ;
  lincat V2 = Verb ** {c2 : Compl} ;
  lincat V3,V2A,V2S,V2Q,V2V = Verb ** {c2,c3 : Compl} ;
  lincat VP = Verb ;
  lincat VPSlash = Verb ** {c2 : Compl} ;
}
