                                                              Pl => "шыд"+base_1+"мады"
                                                            }
                                                    }
                                           }
                              }
                     } ;
        imperative =  table {
                               Pos => table {
                                        Informal => table {
                                                      Sg => "шыд"+base_1 ;
                                                      Pl => "шыд"+base_1+"ыңдар"
                                                    } ;
                                        Formal => table {
                                                    Sg => "шыд"+base_1+"ыңыз" ;
                                                    Pl => "шыд"+base_1+"ыңыздар"
                                                  }
                                      } ;
                               Neg => table {
