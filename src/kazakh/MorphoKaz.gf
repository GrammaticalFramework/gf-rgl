mkN012 : Str -> N ;
mkN012 base =
  case base of {
    base_1+base_2@? => lin N
      { s = table {
              Nom => table {
                       Sg => base_1+base_2 ;
                       Pl => base_1+base_2+"лер"
                     } ;
              Acc => table {
                       Sg => base_1+base_2+"ді" ;
                       Pl => base_1+base_2+"лерді"
                     } ;
              Dat => table {
                       Sg => base_1+base_2+"ге" ;
                       Pl => base_1+base_2+"лерге"
                     } ;
              Gen => table {
                       Sg => base_1+base_2+"дің" ;
                       Pl => base_1+base_2+"лердің"
                     } ;
              Ablat => table {
                         Sg => base_1+base_2+"ден" ;
                         Pl => base_1+base_2+"лерден"
                       } ;
              Instr => table {
                         Sg => base_1+base_2+"мен" ;
                         Pl => base_1+base_2+"лермен"
                       } ;
              Loc => table {
                       Sg => base_1+base_2+"де" ;
                       Pl => base_1+"ле"+base_2+"де"
                     }
            } ;
        poss = table {
                 Sg => table {
                         P1 => table {
                                 Sg => nonExist ;
                                 Pl => nonExist
                               } ;
                         P2 Informal => table {
                                          Sg => nonExist ;
                                          Pl => nonExist
                                        } ;
                         P2 Formal => table {
                                        Sg => nonExist ;
                                        Pl => nonExist
                                      } ;
                         P3 => table {
                                 Sg => nonExist ;
                                 Pl => nonExist
                               }
                       } ;
                 Pl => table {
                         P1 => table {
                                 Sg => nonExist ;
                                 Pl => nonExist
                               } ;
                         P2 Informal => table {
                                          Sg => nonExist ;
                                          Pl => nonExist
                                        } ;
                         P2 Formal => table {
                                        Sg => nonExist ;
                                        Pl => nonExist
                                      } ;
                         P3 => table {
                                 Sg => nonExist ;
                                 Pl => nonExist
                               }
                       }
               }
      };
    _ => error "Can't apply paradigm mkN012"
  } ;

