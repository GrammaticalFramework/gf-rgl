resource MorphoKaz = open CatKaz, ResKaz, Predef in {

oper

mkN001 : Str -> N ;
mkN001 base_1 =
  lin N
  { s = table {
          Nom => table {
                   Sg => base_1 ;
                   Pl => base_1+"тар"
                 } ;
          Acc => table {
                   Sg => base_1+"ты" ;
                   Pl => base_1+"тарды"
                 } ;
          Dat => table {
                   Sg => base_1+"қа" ;
                   Pl => base_1+"тарға"
                 } ;
          Gen => table {
                   Sg => base_1+"тың" ;
                   Pl => base_1+"тардың"
                 } ;
          Ablat => table {
                     Sg => base_1+"тан" ;
                     Pl => base_1+"тардан"
                   } ;
          Instr => table {
                     Sg => base_1+"пен" ;
                     Pl => base_1+"тармен"
                   } ;
          Loc => table {
                   Sg => base_1+"та" ;
                   Pl => base_1+"тарда"
                 }
        } ;
    poss = table {
             Sg => table {
                     P1 => table {
                             Sg => base_1+"ым" ;
                             Pl => base_1+"тарым"
                           } ;
                     P2 Informal => table {
                                      Sg => base_1+"ыңыз" ;
                                      Pl => base_1+"тарыңыз"
                                    } ;
                     P2 Formal => table {
                                    Sg => base_1+"ың" ;
                                    Pl => base_1+"тарың"
                                  } ;
                     P3 => table {
                             Sg => base_1+"ы" ;
                             Pl => base_1+"тары"
                           }
                   } ;
             Pl => table {
                     P1 => table {
                             Sg => base_1+"ымыз" ;
                             Pl => base_1+"тарымыз"
                           } ;
                     P2 Informal => table {
                                      Sg => nonExist ;
                                      Pl => nonExist
                                    } ;
                     P2 Formal => table {
                                    Sg => nonExist ;
                                    Pl => nonExist
                                  } ;
                     P3 => table {
                             Sg => nonExist ;
                             Pl => nonExist
                           }
                   }
           }
  } ;

