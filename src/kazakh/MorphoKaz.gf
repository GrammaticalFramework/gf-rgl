                                                              Pl => base_1+"меді"
                                                            }
                                                    }
                                           }
                              }
                     } ;
        imperative =  table {
                               Pos => table {
                                        Informal => table {
                                                      Sg => base_1 ;
                                                      Pl => case base_1 of {_ + "ы" => base_1+"ңдар"; _ => base_1+"іңдер"}
                                                    } ;
                                        Formal => table {
                                                    Sg => case base_1 of {_ + "ы" => base_1+"ңыз"; _ => base_1+"іңіз"} ;
                                                    Pl => case base_1 of {_ + "ы" => base_1+"ңыздар"; _ => base_1+"іңіздер"}
