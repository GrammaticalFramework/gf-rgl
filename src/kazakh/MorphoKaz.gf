                                                                 Pl => "шыд"+base_1+"п жатырмай"
                                                               }
                                                       }
                                              } ;
                                noAspect = table {
                                             Pos => table {
                                                      P1 => table {
                                                              Sg => "шыд"+base_1+"ймын" ;
                                                              Pl => "шыд"+base_1+"ймыз"
                                                            } ;
                                                      P2 Informal => table {
