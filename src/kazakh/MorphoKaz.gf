                                                              Pl => "шыд"+base_1+"йды"
                                                            }
                                                    } ;
                                             Neg => table {
                                                      P1 => table {
                                                              Sg => "шыд"+base_1+"ймаймын" ;
                                                              Pl => "шыд"+base_1+"ймайсыңдар"
                                                            } ;
                                                      P2 Informal => table {
                                                                       Sg => "шыд"+base_1+"ймайсың" ;
                                                                       Pl => "шыд"+base_1+"ймайсыздар"
                                                                     } ;
                                                      P2 Formal => table {
