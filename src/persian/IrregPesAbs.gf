    bordan_V : V ;
    paziroftan_V : V ;
    pokhtan_V : V ;
    pardakhtan_V : V ;
    peyvastan_V : V ;
    tavanestan_V : V ;
    jostan_V : V ;
    khordan_V : V ;
    dadan_V : V ;
    danestan_V : V ;
    didan_V : V ;
    randan_V : V ;
    raftan_V : V ;
    rikhtan_V : V ;
    sepordan_V : V ;
    zadan_V : V ;
    zistan_V : V ;
    sakhtan_V : V ;
    shenakhtan_V : V ;
    shenidan_V : V ;
    shomordan_V : V ;
