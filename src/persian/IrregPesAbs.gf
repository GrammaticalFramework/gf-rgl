-- Irregular Persian verbs and verb stems used to build compounds.
-- A regular suffix base is listed only once; prefixed and multiword verbs are
-- built from it with compoundV in the concrete lexicon.
abstract IrregPesAbs = Cat ** {
  fun
    kardan_V : V ;
    shodan_V : V ;
    dashtan_V : V ;
    budan_V : V ;
    amadan_V : V ;
