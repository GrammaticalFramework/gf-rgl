        NLocV => variants {Predef.tk 2 w + "ళ్లలోనూ" ; Predef.tk 1 w + "్లలోనూ"}
      }
    } ;
    g = Neutr
  } ;

  oper pN_aMwa : NParadigm = \w -> {
    s = table {
