  oper pN_Uru : NParadigm = \w -> {
    s = table {
      Sg => table {
        NDir => w ;
        NObl => Predef.tk 1 w + "ి" ;
        NAcc => variants {w + "ని" ; Predef.tk 1 w + "ిని"} ;
        NLoc => Predef.tk 1 w + "ి" ;
        NDirA => Predef.tk 1 w + "ా" ;
        NDire => Predef.tk 1 w + "ే" ;
        NDiro => Predef.tk 1 w + "ో" ;
        NAccA => variants {Predef.tk 1 w + "ినా" ; w + "నా"} ;
        NAcce => variants {Predef.tk 1 w + "ినే" ; w + "నే"} ;
        NAcco => variants {Predef.tk 1 w + "ినో" ; w + "నో"} ;
        NDatA => variants {Predef.tk 1 w + "ికా" ; w + "కా"} ;
        NDate => variants {Predef.tk 1 w + "ికే" ; w + "కే"} ;
        NDato => Predef.tk 1 w + "ికో" ;
        NInsA => variants {Predef.tk 1 w + "ితోనా" ; w + "తోనా"} ;
        NInse => variants {Predef.tk 1 w + "ితోనే" ; w + "తోనే"} ;
        NInso => variants {Predef.tk 1 w + "ితోనో" ; w + "తోనో"} ;
        NLocA => variants {Predef.tk 1 w + "ిలోనా" ; w + "లోనా" ; Predef.tk 2 w + "ళ్లోనా"} ;
        NLoce => variants {Predef.tk 1 w + "ిలోనే" ; w + "లోనే" ; Predef.tk 2 w + "ళ్లోనే"} ;
        NLoco => variants {Predef.tk 1 w + "ిలోనో" ; w + "లోనో" ; Predef.tk 2 w + "ళ్లోనో"} ;
        NDirV => variants {Predef.tk 1 w + "ూ" ; Predef.tk 1 w + "ూను" ; w + "న్నూ"} ;
        NAccV => variants {Predef.tk 1 w + "ినీ" ; w + "నూ"} ;
        NDatV => variants {Predef.tk 1 w + "ికీ" ; w + "కూ"} ;
        NInsV => variants {Predef.tk 1 w + "ితోనూ" ; w + "తోనూ"} ;
