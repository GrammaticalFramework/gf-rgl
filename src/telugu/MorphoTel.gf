        NAcco => variants {Predef.tk 2 w + "న్నిటినో" ; Predef.tk 2 w + "న్నింటినో"} ;
        NDatA => variants {Predef.tk 2 w + "న్నిటికా" ; Predef.tk 2 w + "న్నింటికా"} ;
