  oper mkNoun : NParadigm -> Str -> Noun = \p,w ->
    let an = p w in {
      s = table {
            Sg => table {
                    Dir => an.s ! Sg ! NDir ;
                    Obl => an.s ! Sg ! NObl ;
                    Acc => an.s ! Sg ! NAcc ;
                    Loc => an.s ! Sg ! NLoc
                  } ;
            Pl => table {
                    Dir => an.s ! Pl ! NDir ;
                    Obl => an.s ! Pl ! NObl ;
                    Acc => an.s ! Pl ! NAcc ;
                    Loc => an.s ! Pl ! NLoc
                  }
          } ;
      g = an.g
    } ;


  -- Long and irregular endings precede productive defaults, as in
  -- ParadigmsMkd. The names refer to the representative Amba lemmas.
  oper guessNParadigm : Str -> NParadigm = \w -> case w of {
        _ + "ఇల్లు" => pN_illu ;
        "కన్ను" => pN_kannu ;
        "పన్ను" => pN_kannu ;
        "మన్ను" => pN_peVnnu ;
        "చెయ్యి" => pN_goyi ;
        "చేయి" => pN_goyi ;
        "వెయ్యి" => pN_veVyyi ;
        "రాయి" => pN_xrAyi ;
        "అబ్బాయి" => pN_abbAyi ;
        "ఎనిమిది" => pN_eVn_m_xi ;
        "మనిషి" => pN_man_Ri ;
        "రాణి" => pN_rANi ;
        "రాత్రి" => pN_rAwri ;
        "దారి" => pN_xAri ;
        "పని" => pN_pani ;
        "పులి" => pN_puli ;
        "బండి" => pN_baMdi ;
        "పిండి" => pN_piMdi ;
        "పండు" => pN_guMdu ;
        "గుడ్డు" => pN_guddu ;
        "గుడి" => pN_gudi ;
        "గూడు" => pN_gUdu ;
        "మెదడు" => pN_meVxadu ;
        "బాలుడు" => pN_bAludu ;
        "పిల్లవాడు" => pN_pillavAdu ;
        "స్నేహితుడు" => pN_snehiwudu ;
        "పాలు" => pN_pAlu ;
        "నూరు" => pN_nUru ;
        "ఊరు" => pN_Uru ;
        "పువ్వు" => pN_pUvu ;
        "కుందేలు" => pN_kuMxelu ;
        "కోతి" => pN_koti ;
        "కోటు" => pN_kotu ;
        "కొట్టు" => pN_koVttu ;
    stem + "ుడు" => pN_snehiwudu ;
    stem + "వాడు" => pN_pillavAdu ;
    stem + "ం" => pN_puswakaM ;
    stem + "లు" => pN_velu ;
    stem + "య్యి" => pN_goyi ;
    stem + "ాయి" => pN_abbAyi ;
    stem + "ండి" => pN_piMdi ;
    stem + "ండు" => pN_beVMdu ;
    stem + "ట్టు" => pN_koVttu ;
    stem + "టు" => pN_kotu ;
    stem + "టి" => pN_koti ;
    stem + "ణి" => pN_rANi ;
    stem + "రి" => pN_xAri ;
    stem + "లి" => pN_puli ;
    stem + "ని" => pN_pani ;
    stem + "డి" => pN_gudi ;
    stem + "ి" => pN_gaxi ;
    stem + "ు" => pN_meku ;
    stem + "ె" => pN_peVtteV ;
    stem + "ీ" => pN_rikRA ;
    stem + "ా" => pN_rikRA ;
    _ => pN_kota
    } ;

  oper regNoun : Str -> Noun = \w ->
    mkNoun (guessNParadigm w) w ;


  oper positiveAgr : (FullVForm => Str) -> Agr -> Str = \fs,a -> case a of {
      Ag _ Sg P1 => fs ! FullVForm_tam_wA_person_1_e ;
      Ag _ Sg P2 => fs ! FullVForm_tam_wA_person_2_e ;
      Ag Masc Sg P3 => fs ! FullVForm_tam_wA_person_3_pu_e ;
      Ag _ Sg P3 => fs ! FullVForm_tam_wA_person_3_non_pu_e ;
      Ag _ Pl P1 => fs ! FullVForm_tam_wA_person_1_ba ;
      Ag Neutr Pl P3 => fs ! FullVForm_tam_wA_person_3_na_ba ;
      Ag _ Pl _ => fs ! FullVForm_tam_wA_person_23_ba
  } ;
  oper presentAgr : (FullVForm => Str) -> Agr -> Str = \fs,a -> case a of {
      Ag _ Sg P1 => fs ! FullVForm_tam_wunn_person_1_e ;
      Ag _ Sg P2 => fs ! FullVForm_tam_wunn_person_2_e ;
      Ag Masc Sg P3 => fs ! FullVForm_tam_wunn_person_3_pu_e ;
      Ag _ Sg P3 => fs ! FullVForm_tam_wunn_person_3_non_pu_e ;
      Ag _ Pl P1 => fs ! FullVForm_tam_wunn_person_1_ba ;
      Ag Neutr Pl P3 => fs ! FullVForm_tam_wunn_person_3_na_ba ;
      Ag _ Pl _ => fs ! FullVForm_tam_wunn_person_23_ba
  } ;
  oper pastAgr : (FullVForm => Str) -> Agr -> Str = \fs,a -> case a of {
      Ag _ Sg P1 => fs ! FullVForm_tam_A_person_1_e ;
      Ag _ Sg P2 => fs ! FullVForm_tam_A_person_2_e ;
      Ag Masc Sg P3 => fs ! FullVForm_tam_A_person_3_pu_e ;
      Ag _ Sg P3 => fs ! FullVForm_tam_A_person_3_non_pu_e ;
      Ag _ Pl P1 => fs ! FullVForm_tam_A_person_1_ba ;
      Ag Neutr Pl P3 => fs ! FullVForm_tam_A_person_3_na_ba ;
      Ag _ Pl _ => fs ! FullVForm_tam_A_person_23_ba
  } ;
  oper negativeAgr : (FullVForm => Str) -> Agr -> Str = \fs,a -> case a of {
      Ag _ Sg P1 => fs ! FullVForm_tam_a_person_1_e ;
      Ag _ Sg P2 => fs ! FullVForm_tam_a_person_2_e_3_na_ba ;
      Ag Masc Sg P3 => fs ! FullVForm_tam_a_person_3_pu_e ;
      Ag _ Sg P3 => fs ! FullVForm_tam_a_person_3_non_pu_e ;
      Ag _ Pl P1 => fs ! FullVForm_tam_a_person_1_ba ;
      Ag Neutr Pl P3 => fs ! FullVForm_tam_a_person_2_e_3_na_ba ;
      Ag _ Pl _ => fs ! FullVForm_tam_a_person_23_ba
  } ;

  oper mkVerb : VParadigm -> Str -> Verb = \p,w ->
    let av = p w in {
      s = table {
        VInf => av ! FullVForm_tam_adaM_person_any ;
        VStem => w ;
        VPresent a => presentAgr av a ;
        VPast a => pastAgr av a ;
        VFuture Pos a => positiveAgr av a ;
        VFuture Neg a => negativeAgr av a ;
        VNegFinite => av ! FullVForm_tam_neg_np_person_any ;
        VPresentPart => av ! FullVForm_tam_wunna_person_any ;
        VRelativePresent => av ! FullVForm_tam_e_person_any ;
        VPastPart => av ! FullVForm_tam_ina_person_any ;
        VHortative => av ! FullVForm_tam_xA_person_12_ba ;
        VNoun => av ! FullVForm_tam_adaM_person_any ;
        VSubj n p => negativeAgr av (Ag Masc n p) ;
        VAbs => av ! FullVForm_tam_i_person_any ;
        VImp Sg Pos => av ! FullVForm_tam_AjFArWa_person_2_e ;
        VImp Pl Pos => av ! FullVForm_tam_AjFArWa_person_2_ba ;
        VImp Sg Neg => av ! FullVForm_tam_aku_person_2_e ;
        VImp Pl Neg => av ! FullVForm_tam_aku_person_2_ba
        } ;
      passive = passiveConjugation w
      } ;
  
  oper guessVParadigm : Str -> VParadigm = \w -> case w of {
        "చూడు" => pV_cUdu ;
        "అడుగు" => pV_poVg_du ;
        "చెప్పు" => pV_ceVppu ;
        "చేయు" => pV_ceVyyi ;
        "చెయ్యి" => pV_ceVyyi ;
        "ఇవ్వు" => pV_ivvu ;
        "వచ్చు" => pV_vaccu ;
        "ఉండు" => pV_uMdu ;
        "వెళ్ళు" => pV_veVlYlu ;
        "తిను" => pV_koVnu ;
        "విను" => pV_koVnu ;
        "కొను" => pV_koVnu ;
        "తన్ను" => pV_wannu ;
        "చావు" => pV_cAvu ;
        "రాయి" => pV_rAyi ;
        "రాయు" => pV_rAyi ;
        "తీయు" => pV_wiyyi ;
        "పూయు" => pV_puyyi ;
        "పో" => pV_po ;
        "లే" => pV_le ;
    stem + "జెయ్యి" => pV_ceVyyi ;
    stem + "చెయ్యి" => pV_ceVyyi ;
    stem + "చేయు" => pV_ceVyyi ;
    stem + "జేయు" => pV_ceVyyi ;
    stem + "చూడు" => pV_cUdu ;
    stem + "అడుగు" => pV_poVg_du ;
    stem + "చెప్పు" => pV_ceVppu ;
    stem + "ఇవ్వు" => pV_ivvu ;
    stem + "తిను" => pV_koVnu ;
    stem + "విను" => pV_koVnu ;
    stem + "తీయు" => pV_wiyyi ;
    stem + "రాయు" => pV_rAyi ;
    stem + "తియ్యి" => pV_wiyyi ;
    stem + "ించు" => pV_cUpiMcu ;
    stem + "పెట్టు" => pV_peVttu ;
    stem + "పట్టు" => pV_peVttu ;
    stem + "గొట్టు" => pV_peVttu ;
    stem + "పడు" => pV_padu ;
    stem + "బడు" => pV_padu ;
    stem + "వడు" => pV_padu ;
    stem + "ుకో" => pV_kUrco ;
    stem + "కొను" => pV_koVnu ;
    stem + "గొను" => pV_koVnu ;
    stem + "పో" => pV_po ;
    stem + "వ్వు" => pV_avvu ;
    stem + "వచ్చు" => pV_vaccu ;
    stem + "ఉండు" => pV_uMdu ;
    stem + "పెరుగు" => pV_poVg_du ;
    stem + "వెళ్ళు" => pV_veVlYlu ;
    stem + "రాయి" => pV_rAyi ;
    stem + "పూయు" => pV_puyyi ;
    stem + "ియు" => pV_kuriyu ;
    stem + "యు" => pV_rAyi ;
    stem + "ువు" => pV_aruvu ;
    stem + "ాడు" => pV_Adu ;
    stem + "ారు" => pV_kAlu ;
    stem + "ీరు" => pV_kAlu ;
    _ => pV_pannu
    } ;

  oper regVerb : Str -> Verb = \w ->
    mkVerb (guessVParadigm w) w ;

  oper mkAdjective : AParadigm -> Str -> Adjective = \p,w ->
    let an = p w in {
      s = \\g,n,c => case <g,n,c> of {
        <Masc,Sg,Dir> => w ;
        <Masc>        => w ;
        _             => w
        }
      } ;

}
