        NObl => variants {Predef.tk 2 w + "ళ్ల" ; Predef.tk 1 w + "్ల"} ;
        NAcc => variants {Predef.tk 2 w + "ళ్లని" ; Predef.tk 1 w + "్లని" ; Predef.tk 2 w + "ళ్లను" ; Predef.tk 1 w + "్లను"} ;
        NLoc => Predef.tk 2 w + "ళ్లల్" ;
        NDirA => variants {Predef.tk 2 w + "ళ్లా" ; Predef.tk 1 w + "్లా"} ;
        NDire => variants {Predef.tk 2 w + "ళ్లే" ; Predef.tk 1 w + "్లే"} ;
        NDiro => variants {Predef.tk 2 w + "ళ్లో" ; Predef.tk 1 w + "్లో"} ;
        NAccA => variants {Predef.tk 2 w + "ళ్లనా" ; Predef.tk 1 w + "్లనా"} ;
        NAcce => variants {Predef.tk 2 w + "ళ్లనే" ; Predef.tk 1 w + "్లనే"} ;
        NAcco => variants {Predef.tk 2 w + "ళ్లనో" ; Predef.tk 1 w + "్లనో"} ;
        NDatA => variants {Predef.tk 2 w + "ళ్లకా" ; Predef.tk 1 w + "్లకా"} ;
        NDate => variants {Predef.tk 2 w + "ళ్లకే" ; Predef.tk 1 w + "్లకే"} ;
        NDato => variants {Predef.tk 2 w + "ళ్లకో" ; Predef.tk 1 w + "్లకో"} ;
        NInsA => variants {Predef.tk 2 w + "ళ్లతోనా" ; Predef.tk 1 w + "్లతోనా" ; Predef.tk 2 w + "ళ్లతోటా" ; Predef.tk 1 w + "్లతోటా"} ;
        NInse => variants {Predef.tk 2 w + "ళ్లతోనే" ; Predef.tk 1 w + "్లతోనే" ; Predef.tk 2 w + "ళ్లతోటే" ; Predef.tk 1 w + "్లతోటే"} ;
        NInso => variants {Predef.tk 2 w + "ళ్లతోనో" ; Predef.tk 1 w + "్లతోనో" ; Predef.tk 2 w + "ళ్లతోటో" ; Predef.tk 1 w + "్లతోటో"} ;
        NLocA => variants {Predef.tk 2 w + "ళ్లలోనా" ; Predef.tk 1 w + "్లలోనా"} ;
        NLoce => variants {Predef.tk 2 w + "ళ్లలోనే" ; Predef.tk 1 w + "్లలోనే"} ;
        NLoco => variants {Predef.tk 2 w + "ళ్లలోనో" ; Predef.tk 1 w + "్లలోనో"} ;
        NDirV => variants {Predef.tk 2 w + "ళ్లూ" ; Predef.tk 1 w + "్లూ" ; Predef.tk 2 w + "ళ్లూను" ; Predef.tk 1 w + "్లూను" ; Predef.tk 2 w + "ళ్లున్నూ" ; Predef.tk 1 w + "్లున్నూ"} ;
        NAccV => variants {Predef.tk 2 w + "ళ్లనూ" ; Predef.tk 1 w + "్లనూ"} ;
        NDatV => variants {Predef.tk 2 w + "ళ్లకూ" ; Predef.tk 1 w + "్లకూ"} ;
