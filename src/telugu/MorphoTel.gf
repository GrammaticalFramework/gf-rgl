        NDato => variants {Predef.tk 2 w + "న్నిటికో" ; Predef.tk 2 w + "న్నింటికో"} ;
        NInsA => variants {Predef.tk 2 w + "న్నిటితోనా" ; Predef.tk 2 w + "న్నింటితోనా" ; Predef.tk 2 w + "న్నిటితోటా" ; Predef.tk 2 w + "న్నింటితోటా"} ;
